# UtilityLens Environment Configuration

# Backend Configuration
DATABASE_URL=sqlite:////app/data/utilities.db

# Frontend Configuration
VITE_API_URL=http://backend:8000

# Allowed Hosts for Vite Dev / Preview Server
# Supports: "true" / "all" (allow all hosts, tunnels, reverse proxies), or comma-separated hostnames (e.g., "localhost,home.local,my-tunnel.com")
VITE_ALLOWED_HOSTS=true
